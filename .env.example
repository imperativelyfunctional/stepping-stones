# Optional: copy to .env to override the defaults in docker-compose.yml
POSTGRES_USER=stepping
POSTGRES_PASSWORD=stepping
POSTGRES_DB=stepping_stones

# Host port for the backend API. Change it if 8000 is already in use.
# BACKEND_PORT=8001

# Host port for Postgres. Change it if 5432 is already in use (e.g. a local Postgres).
# The backend still reaches the database on 5432 inside Docker, so nothing else changes.
# POSTGRES_PORT=5433
